<Project Sdk="Microsoft.Build.NoTargets">

  <!-- Common project properties -->
  <PropertyGroup>
    <Title>Buildvana.Cake</Title>
    <Description>CakeBuild scripts used with Buildvana.Sdk</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Package properties -->
  <PropertyGroup>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <!-- Warning suppressions -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5128</NoWarn> <!-- Missing binaries - because there are none. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="Content\\**\\*" Pack="true" PackagePath="Content" />
  </ItemGroup>

</Project>
